/**
 * Problem: Count Binary Strings without Consecutive 1s
 * Approach: Recursive Backtracking (Decision Tree)
 * Intuition: Each string is built bit-by-bit. If the current bit is 0, the next 
 *            bit can be either 0 or 1. If the current bit is 1, the next bit 
 *            must be 0 to maintain the "no consecutive 1s" rule. We count 
 *            successful paths that reach length 'n'.
 * Complexity:
 *    - Time: O(2^n) | Each state explores up to two branches.
 *    - Space: O(n)   | Recursion stack depth equals the length of the string.
 */

class Solution {
public:
    /**
     * Recursive helper to explore valid bit transitions
     * @param n      Target length of the binary string
     * @param num    The value of the bit at the current index (0 or 1)
     * @param index  The current position being filled (1-based)
     */
    int helper(int n, int num, int index) {
        int count = 0;

        // Base case: current path has reached the required length
        if (index == n) {
            return 1;
        }

        // Branching logic based on current bit value
        if (num == 0) {
            // After a 0, we can safely place either 0 or 1
            count = helper(n, 0, index + 1) + helper(n, 1, index + 1);
        } 
        else if (num == 1) {
            // After a 1, we must place a 0 to avoid consecutive 1s
            count = helper(n, 0, index + 1);
        }

        return count;
    }

    /**
     * Main function to initiate the recursive count
     */
    int countStrings(int n) {
        // Handle n=0 as a boundary edge case
        if (n <= 0) return 0;

        // Total count is sum of paths starting with '0' and paths starting with '1'
        int sum = helper(n, 0, 1) + helper(n, 1, 1);

        return sum;
    }
};
