// 🔤 Check if two strings are anagrams
// Logic: Count frequency of characters in s, subtract using t
// If all counts become 0 → valid anagram

class Solution {
public:
    bool isAnagram(string s, string t) {
        // Step 1: Length check
        if (s.size() != t.size()) return false;

        // Step 2: Frequency array (for lowercase letters)
        int freq[26] = {0};

        // Step 3: Count characters from s
        for (char c : s) {
            freq[c - 'a']++;
        }

        // Step 4: Subtract using t
        for (char c : t) {
            freq[c - 'a']--;
        }

        // Step 5: Check if all values are zero
        for (int i = 0; i < 26; i++) {
            if (freq[i] != 0) return false;
        }

        return true;
    }
};
