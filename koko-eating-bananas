class Solution {
public:
    // Helper function to calculate total hours needed at speed k
    int calculateTime(const vector<int>& piles, int k) {
        int totalTime = 0;

        for (int bananas : piles) {
            totalTime += (bananas + k - 1) / k;  // ceil division
        }

        return totalTime;
    }

    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1;
        int high = *max_element(piles.begin(), piles.end());
        int answer = high;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (calculateTime(piles, mid) <= h) {
                answer = mid;
                high = mid - 1;  // try smaller speed
            } else {
                low = mid + 1;   // need higher speed
            }
        }

        return answer;
    }
};
