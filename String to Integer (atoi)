class Solution {
public:
    int myAtoi(string s) {
        int count = 0;          // 0 = positive, 1 = negative
        long long num = 0;     // stores final number safely

        int n = s.size();
        int i = 0;

        // Step 1: Skip leading spaces
        while (i < n && s[i] == ' ')
            i++;

        // Step 2: Check sign (+ or -)
        if (i < n && (s[i] == '-' || s[i] == '+')) {
            if (s[i] == '-')
                count = 1;
            i++;
        }

        // Step 3: Read digits and build number
        while (i < n) {

            // Stop if current character is not a digit
            if (!isdigit((unsigned char)s[i]))
                break;

            // Convert char digit to integer and append
            num = num * 10 + (s[i] - '0');

            // Step 4: Handle positive overflow
            if (count == 0 && num > 2147483647LL)
                return 2147483647;

            // Step 5: Handle negative overflow
            if (count == 1 && -num < -2147483648LL)
                return -2147483648;

            i++;
        }

        // Step 6: Return result with correct sign
        if (count == 1)
            return (int)-num;

        return (int)num;
    }
};
