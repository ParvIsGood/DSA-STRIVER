lower bound/insert element 
class Solution {
  public:
    int lowerBound(vector<int>& arr, int target) {
        // code here
        int n = arr.size();
        int l =0;
       int  ans = n;
        int r = n-1;
        while(l<=r){
            int m = (l+r)/2;
            if(arr[m]<target){
                l = m+1;
            }
            else if(arr[m]>=target){
                ans = m;
                r = m-1;
            }
        }
        return ans;
    }
};
