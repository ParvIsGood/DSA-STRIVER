/**
 * Problem: Add Number Represented as Linked List (Add One)
 * Source:  Generic Utility / Coding Interview Classic
 * 
 * Approach: Reverse, increment, and reverse back.
 * 
 * Intuition: Linked lists are forward-pointing, but addition flows from right to left (LSB to MSB).
 * To handle carries naturally, we flip the list to process the units digit first. We traverse
 * through the nodes, carrying over the '+1' until no carry remains. If we finish the list
 * with a carry still active (e.g., 999 + 1), we append a new node. Finally, we flip the list 
 * back to its original orientation.
 * 
 * Complexity:
 * - Time: O(N), where N is the number of nodes (Three linear passes: reverse, add, reverse).
 * - Space: O(1), as we modify the existing list in-place (O(1) additional node for new carry).
 */

class Solution {
public:
    /**
     * Reverses a singly linked list in-place.
     */
    Node* reverse(Node* head) {
        if (head == nullptr || head->next == nullptr) return head;

        Node* curr  = head;                                // Track current node during traversal
        Node* prev  = nullptr;                             // Points to the processed portion
        Node* next  = nullptr;                             // Temporarily stores the remaining list

        while (curr != nullptr) {
            next       = curr->next;                       // Save next node before breaking link
            curr->next = prev;                             // Reverse the pointer direction
            prev       = curr;                             // Move prev forward
            curr       = next;                             // Move curr forward
        }
        return prev;                                       // New head of the reversed list
    }

    /**
     * Adds 1 to the number represented by the linked list.
     */
    Node* addOne(Node* head) {
        int carry   = 1;                                   // Initial addition value
        Node* reversedHead = reverse(head);                // Flip to process Least Significant Bit
        Node* temp  = reversedHead;                        // Iterator for the reversed list
        Node* last  = nullptr;                             // Track tail to handle terminal carry

        while (temp != nullptr) {
            int sum = temp->data + carry;                  // Calculate value for current node

            if (sum > 9) {
                temp->data = 0;                            // Reset digit on overflow
                carry      = 1;                            // Propagate carry to next node
            } else {
                temp->data = sum;                          // Apply sum
                carry      = 0;                            // Reset carry
                break;                                     // Exit early if no carry remains
            }

            last = temp;                                   // Update tail pointer
            temp = temp->next;                             // Advance to next digit
        }

        // Handle case where carry propagates beyond the Most Significant Bit (e.g., 99 -> 100)
        if (carry == 1) {
            Node* newNode = new Node(1);                   // Create overflow node
            last->next    = newNode;                       // Link it to the end of reversed list
        }

        return reverse(reversedHead);                      // Restore original list order
    }
};
RECURSSION
/**
 * Problem:   Add 1 to a number represented as a Linked List (e.g., GeeksforGeeks)
 * Approach:  Recursive Backtracking (Post-order Traversal)
 * Intuition: Treat the recursion stack as a way to traverse the list in reverse. 
 *            By moving to the tail first and adding 1 on the way back up, we handle 
 *            carries naturally from the least significant digit to the most.
 * Complexity:
 *   - Time:  O(N) where N is the number of nodes (single pass traversal).
 *   - Space: O(N) for the recursion stack in the worst case (linear list).
 */

class Solution {
public:
    /**
     * Recursively moves to the end of the list and adds carry back up.
     * @param node The current node being processed.
     * @return The carry to be added to the previous node (0 or 1).
     */
    int solveCarry(Node* node) {
        // Base case: Reached the end, return 1 to start the increment
        if (node == nullptr) return 1;

        // Recurse to the next node and capture the resulting carry
        int carry = solveCarry(node->next);

        // Update current node data with carry from the right
        node->data += carry;

        // If no further carry is needed, update and stop propagation
        if (node->data < 10) return 0;

        // Handle overflow: Reset digit to 0 and propagate carry of 1
        node->data = 0;
        return 1;
    }

    /**
     * Main function to add one to the linked list number.
     */
    Node* addOne(Node* head) {
        // Calculate carry starting from the head via recursion
        int finalCarry = solveCarry(head);

        // If a carry reaches the head (e.g., 999 -> 1000), create a new MSB
        if (finalCarry == 1) {
            Node* newHead = new Node(1); // Create node for the new highest digit
            newHead->next = head;        // Link it to the existing list
            return newHead;              // Return the new starting point
        }

        return head; // Return original head if no new digit was created
    }
};
