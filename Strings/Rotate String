// 🔁 Check if one string is rotation of another
// Logic: s + s will contain all possible rotations of s
// If goal is a substring of (s + s), then it's a valid rotation

class Solution {
public:
    bool rotateString(string s, string goal) {
        // Step 1: Length check
        if (s.size() != goal.size()) return false;

        // Step 2: Create doubled string
        string doubleS = s + s;

        // Step 3: Check if goal exists in doubled string
        return doubleS.find(goal) != string::npos;
    }
};
