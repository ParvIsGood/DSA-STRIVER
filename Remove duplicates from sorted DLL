class Solution {
  public:
  Node* remove(Node* head){
      Node* temp = head;
      Node* back = temp->prev;
      Node* front = temp->next;
      if(front==NULL){
          back->next = front;
      }
      else {
          back->next = front;
          front->prev = back;
      }
      delete temp;
      return front;
  }
    Node* removeDuplicates(Node* head) {
Node* temp = head;
int x = -1;
while(temp!=NULL){
    if(temp->data == x){
     temp  =   remove(temp);
    }
    else {
        x = temp->data;
        temp = temp->next;
    }
    
}
return head;
    }
};
