class Solution {
public:
    int myAtoi(string s) {
        // Start with index i = 0
        return helper(s, 0, 0, false, 1);
    }
    
    int helper(const string& s, int i, long long ans, bool check, int sign) {
        int n = s.size();

        // Base case: If we reach the end of the string
        if (i == n) {
            return (int)(ans * sign);
        }

        // Skip leading whitespaces
        if (s[i] == ' ' && check == false) {
            return helper(s, i + 1, ans, check, sign);
        }

        // Check for signs
        if (check == false) {
            if (s[i] == '-') {
                return helper(s, i + 1, ans, true, -1);
            } 
            else if (s[i] == '+') {
                return helper(s, i + 1, ans, true, 1);
            }
        }

        // Process digits
        if (isdigit(s[i])) {
            int digit = s[i] - '0';
            check = true;
            
            // Check for overflow/underflow BEFORE updating 'ans' 
            // This prevents a crash if a test case provides 100+ consecutive digits
            if (ans > INT_MAX / 10 || (ans == INT_MAX / 10 && digit > 7)) {
                return (sign == 1) ? INT_MAX : INT_MIN;
            }
            
            ans = ans * 10 + digit;
            
            return helper(s, i + 1, ans, check, sign);
        }
        // If it's a non-digit character after we started, or an invalid start character
        else {
            return (int)(ans * sign);
        }
    }
};
