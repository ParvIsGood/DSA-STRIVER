class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* dummy = new ListNode(0);
        ListNode* temp = dummy;  
    
        int carry = 0;
        int sum = 0;

        while(l1 != NULL || l2 != NULL){
            
            if(l1 == NULL){
                sum = l2->val + carry;
                l2 = l2->next;
            }
            else if(l2 == NULL){
                sum = l1->val + carry;
                l1 = l1->next;
            }
            else{
                sum = l1->val + l2->val + carry;
                l1 = l1->next;
                l2 = l2->next;
            }

            carry = sum / 10;

            ListNode* newn = new ListNode(sum % 10);
            temp->next = newn;
            temp = temp->next;
        }

        // 🔥 important fix
        if(carry==1){
            temp->next = new ListNode(carry);
        }

        return dummy->next;
    }
};
