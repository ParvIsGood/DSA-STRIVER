BRUTEEEE/**
 * Problem: LeetCode 141 - Linked List Cycle
 * Approach: Hash Map Tracking
 * Intuition: We traverse the linked list node by node, storing each node's address in a hash map. 
 * If we encounter a node that already exists in the map, it implies we have revisited 
 * a location, confirming the existence of a cycle. This provides a straightforward way 
 * to track visited states without modifying the input list structure.
 * Complexity: Time: O(n) where n is the number of nodes; Space: O(n) to store node pointers in the map.
 */

/**
 * Definition for singly-linked list.
 * struct ListNode {
 * int val;
 * ListNode *next;
 * ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    bool hasCycle(ListNode *head) {
        // Map to keep track of visited nodes to detect cycles
        unordered_map<ListNode*, int> mpp;
        ListNode* temp = head;

        // Iterate through the list until the end
        while (temp != NULL) {
            // Check if the current node has been visited before
            if (mpp.find(temp) != mpp.end()) {
                return true; // Cycle detected
            }

            // Mark the current node as visited in the map
            mpp[temp]++;
            
            // Move the pointer to the next node
            temp = temp->next;
        }

        // No cycle found
        return false;
    }
};
