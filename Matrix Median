class Solution {
public:
    int checkElements(vector<vector<int>>& mat, int r, int c, int mid) {
        int count = 0;

        for (int i = 0; i < r; i++) {
            int low = 0;
            int high = c - 1;
            int ans = -1;

            // Binary search to find last element <= mid in current row
            while (low <= high) {
                int m = low + (high - low) / 2;

                if (mat[i][m] > mid) {
                    high = m - 1;
                } else {
                    ans = m;
                    low = m + 1;
                }
            }

            count += (ans + 1);
        }

        return count;
    }

    int median(vector<vector<int>>& mat) {
        int r = mat.size();
        int c = mat[0].size();

        int low = INT_MAX;
        int high = INT_MIN;

        // Find global minimum and maximum
        for (int i = 0; i < r; i++) {
            low = min(low, mat[i][0]);
            high = max(high, mat[i][c - 1]);
        }

        int req = (r * c) / 2;

        // Binary search on answer space
        while (low <= high) {
            int mid = low + (high - low) / 2;

            int totalElements = checkElements(mat, r, c, mid);

            if (totalElements > req) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
};
