/**
 * Problem: LeetCode 141 - Linked List Cycle
 * Approach: Floyd's Cycle-Finding Algorithm (Tortoise and Hare)
 * Intuition: We use two pointers moving at different speeds. The 'slow' pointer moves one 
 * step at a time, while the 'fast' pointer moves two steps. If there is a cycle, the 
 * fast pointer will eventually "lap" the slow pointer and they will meet at the same node. 
 * If the fast pointer reaches the end of the list, no cycle exists.
 * Complexity: Time: O(n) as the fast pointer traverses the list; Space: O(1) as we only use two pointers.
 */

/**
 * Definition for singly-linked list.
 * struct ListNode {
 * int val;
 * ListNode *next;
 * ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    /**
     * Determines if a linked list contains a cycle using constant extra space.
     * @param head Pointer to the start of the list.
     * @return true if a cycle is detected, false otherwise.
     */
    bool hasCycle(ListNode *head) {
        ListNode* slow = head;         // Initialize slow pointer at head
        ListNode* fast = head;         // Initialize fast pointer at head

        // Traverse until the fast pointer reaches the end of the list
        while (fast != NULL && fast->next != NULL) {
            slow = slow->next;         // Move slow pointer one step
            fast = fast->next->next;   // Move fast pointer two steps

            // If pointers meet, a cycle is detected
            if (slow == fast) {
                return true; 
            }
        }

        // Fast pointer reached the end, no cycle exists
        return false;
    }
};
