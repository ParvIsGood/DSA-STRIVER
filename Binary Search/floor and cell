class Solution {
  public:
    int findFloor(vector<int>& arr, int x) {
int n = arr.size();
int ans = -1;
int low = 0;
int high = n-1;
while(low<=high){
    int m = (low+high)/2;
    if(arr[m]<=x){
        ans = m;
        low  = m+1;
        
    }
    else {
        high = m-1;
    }
}
return ans;
    }
};
