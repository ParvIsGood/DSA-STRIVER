class Solution {
public:
    // Helper: count how many bouquets can be made by given day
    int countBouquets(const vector<int>& bloomDay, int k, int day) {
        int bouquets = 0;
        int flowers = 0;

        for (int bloom : bloomDay) {
            if (bloom <= day) {
                flowers++;
                if (flowers == k) {
                    bouquets++;
                    flowers = 0;
                }
            } else {
                flowers = 0;  // break in continuity
            }
        }

        return bouquets;
    }

    int minDays(vector<int>& bloomDay, int m, int k) {
        long long required = 1LL * m * k;
        if (required > bloomDay.size()) return -1;

     int low = *min_element(bloomday.begin(),bloomday.end());
        int high = *max_element(bloomDay.begin(), bloomDay.end());
        int answer = -1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (countBouquets(bloomDay, k, mid) >= m) {
                answer = mid;
                high = mid - 1;  // try smaller day
            } else {
                low = mid + 1;   // need more days
            }
        }

        return answer;
    }
};
