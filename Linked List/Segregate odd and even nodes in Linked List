/**
 * Problem: LeetCode 328 - Odd Even Linked List
 * Approach: Extra space transformation (Array-based reordering)
 * 
 * Intuition: The strategy involves two passes over the original linked list to 
 * separate node values by their indices (odd-positioned values first, then 
 * even-positioned). By storing these values in a temporary vector and then 
 * overwriting the original list nodes in order, we bypass complex pointer 
 * manipulation while achieving the desired relative ordering.
 * 
 * Complexity:
 * - Time: O(N), where N is the number of nodes (three linear passes).
 * - Space: O(N), to store the node values in a vector.
 */

class Solution {
public:
    ListNode* oddEvenList(ListNode* head) {
        // Handle empty list or single-node list cases early
        if (head == nullptr || head->next == nullptr) return head;

        std::vector<int> arr;
        ListNode* temp = head;

        // Pass 1: Collect values from odd-indexed nodes (1st, 3rd, 5th...)
        while (temp != nullptr && temp->next != nullptr) {
            arr.push_back(temp->val);
            temp = temp->next->next;      // Jump over the even node
        }
        
        // Catch the tail node if the list has an odd number of elements
        if (temp != nullptr) {
            arr.push_back(temp->val);
        }

        // Pass 2: Collect values from even-indexed nodes (2nd, 4th, 6th...)
        temp = head->next;
        while (temp != nullptr && temp->next != nullptr) {
            arr.push_back(temp->val);
            temp = temp->next->next;      // Jump over the odd node
        }
        
        // Catch the tail node if the list has an even number of elements
        if (temp != nullptr) {
            arr.push_back(temp->val);
        }

        // Pass 3: Reassign the collected values back to the original nodes
        temp  = head;
        int i = 0;
        while (temp != nullptr) {
            temp->val = arr[i];           // Overwrite current node value
            i++;                          // Move to next stored value
            temp = temp->next;            // Advance to next node
        }

        return head;
    }
};
OPTIMALL
/**
 * Problem   : LeetCode 328 - Odd Even Linked List
 * Approach  : Two-pointer (Odd and Even) In-place Reordering
 * Intuition : We maintain two separate sub-lists using pointers: one for nodes at odd indices 
 *             and one for nodes at even indices. By skipping nodes (next = next->next) and 
 *             advancing these pointers simultaneously, we effectively "weave" the odd nodes 
 *             together and the even nodes together. Finally, we connect the end of the 
 *             odd list to the start of the even list.
 * Complexity: 
 *   - Time  : O(N), where N is the number of nodes (single pass traversal).
 *   - Space : O(1), as we only rearrange existing nodes without extra data structures.
 */

class Solution {
public:
    ListNode* oddEvenList(ListNode* head) {
        // Handle empty list or single-node list to avoid null pointer access
        if (head == nullptr || head->next == nullptr) return head;

        ListNode* odd   = head;            // Pointer to track the current odd node
        ListNode* even  = head->next;      // Pointer to track the current even node
        ListNode* evenH = head->next;      // Keep track of the even list's head to link later

        // Traverse while there is at least one more even node to process
        while (even != nullptr && even->next != nullptr) {
            odd->next  = odd->next->next;  // Connect current odd to the next odd node
            even->next = even->next->next; // Connect current even to the next even node
            
            odd  = odd->next;              // Advance odd pointer to its new position
            even = even->next;             // Advance even pointer to its new position
        }

        odd->next = evenH;                 // Link the end of the odd list to the head of the even list
        
        return head;                       // Return the modified original head
    }
};
